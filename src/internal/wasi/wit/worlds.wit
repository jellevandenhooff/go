package go:wasip3-proto;

// Full command world — all WASI 0.3 interfaces used by the Go runtime.
// Used by the exec script (go_wasip3_wasm32_exec) when building components.
world command {
  import wasi:cli/environment@0.3.0-rc-2026-02-09;
  import wasi:cli/stdout@0.3.0-rc-2026-02-09;
  import wasi:cli/stderr@0.3.0-rc-2026-02-09;
  import wasi:clocks/types@0.3.0-rc-2026-02-09;
  import wasi:clocks/monotonic-clock@0.3.0-rc-2026-02-09;
  import wasi:clocks/system-clock@0.3.0-rc-2026-02-09;
  import wasi:filesystem/types@0.3.0-rc-2026-02-09;
  import wasi:filesystem/preopens@0.3.0-rc-2026-02-09;
  import wasi:sockets/types@0.3.0-rc-2026-02-09;
  import wasi:random/random@0.3.0-rc-2026-02-09;
  export wasi:cli/run@0.3.0-rc-2026-02-09;
}

// Basic world — just clocks, no async export
world clocks {
  import wasi:clocks/monotonic-clock@0.3.0-rc-2026-02-09;
}

// Async world — exports wasi:cli/run (async) + imports clocks
world clocks-async {
  import wasi:clocks/monotonic-clock@0.3.0-rc-2026-02-09;
  export wasi:cli/run@0.3.0-rc-2026-02-09;
}

// TCP world — clocks + sockets + filesystem + stdio + async export
world tcp-async {
  import wasi:clocks/types@0.3.0-rc-2026-02-09;
  import wasi:clocks/monotonic-clock@0.3.0-rc-2026-02-09;
  import wasi:clocks/system-clock@0.3.0-rc-2026-02-09;
  import wasi:sockets/types@0.3.0-rc-2026-02-09;
  import wasi:filesystem/types@0.3.0-rc-2026-02-09;
  import wasi:filesystem/preopens@0.3.0-rc-2026-02-09;
  import wasi:random/random@0.3.0-rc-2026-02-09;
  import wasi:cli/environment@0.3.0-rc-2026-02-09;
  import wasi:cli/stdout@0.3.0-rc-2026-02-09;
  import wasi:cli/stderr@0.3.0-rc-2026-02-09;
  export wasi:cli/run@0.3.0-rc-2026-02-09;
}

// Filesystem world — clocks + filesystem + stdio + async export
world filesystem-async {
  import wasi:clocks/types@0.3.0-rc-2026-02-09;
  import wasi:clocks/monotonic-clock@0.3.0-rc-2026-02-09;
  import wasi:clocks/system-clock@0.3.0-rc-2026-02-09;
  import wasi:filesystem/types@0.3.0-rc-2026-02-09;
  import wasi:filesystem/preopens@0.3.0-rc-2026-02-09;
  import wasi:random/random@0.3.0-rc-2026-02-09;
  import wasi:cli/environment@0.3.0-rc-2026-02-09;
  import wasi:cli/stdout@0.3.0-rc-2026-02-09;
  import wasi:cli/stderr@0.3.0-rc-2026-02-09;
  export wasi:cli/run@0.3.0-rc-2026-02-09;
}
